        style=&#34;
          width: 100%;
          height: 280px;
          object-fit: cover;
          border-radius: 6px;
          background: var(--code-bg);
        &#34;
        loading=&#34;lazy&#34;
      /&gt;
  &lt;/div&gt;

  
  &lt;div class=&#34;voice-info&#34; style=&#34;flex: 1; min-width: 250px;&#34;&gt;

    
    &lt;h2 style=&#34;margin-top: 0; margin-bottom: 12px; font-size: 1.4em; line-height: 1.3;&#34;&gt;
      [RJ01630624] 枫香，我们二人一同去探求美食的真谛吧♪
    &lt;/h2&gt;

    
      &lt;p style=&#34;margin: 6px 0;&#34;&gt;
        &lt;strong&gt;社团：&lt;/strong&gt;
