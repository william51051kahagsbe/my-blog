      <description>&lt;div class=&#34;voice-card&#34; style=&#34;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 24px;
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  background: var(--entry);
  transition: box-shadow 0.2s;
&#34;&gt;
  
  &lt;div class=&#34;voice-cover&#34; style=&#34;flex: 0 0 200px;&#34;&gt;
      &lt;img
        src=&#34;http://localhost:1313/images/special1.png&#34;
